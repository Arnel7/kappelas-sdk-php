{
    "name": "kappelas/kappelas-sdk-php",
    "description": "Official PHP SDK for the Kappela messaging platform — v0.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arnel LAWSON",
            "email": "arnellawson7@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "textalk/websocket": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kappelas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kappelas\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
